<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>BrickLink - Buy and sell LEGO Parts, Sets and Minifigures</title>
    <link rel="icon" type="image/x-icon" href="img/favicon/favicon.ico">
    <link rel="stylesheet" href="//maxcdn.bootstrapcdn.com/font-awesome/4.5.0/css/font-awesome.min.css">
    <script>
        function getNextDayESTDate() {
            // Get current UTC time
            var now = new Date();

            // Get offset for EST (UTC-5)
            var offset = -5 * 60;

            // Adjust time based on offset
            now.setMinutes(now.getMinutes() + offset);

            // Add one day
            now.setDate(now.getDate() + 1);

            // Format date
            var month = now.getUTCMonth() + 1; // months are zero-based
            var day = now.getUTCDate();
            var year = now.getUTCFullYear();

            // Add leading zero if needed
            month = (month < 10) ? "0" + month : month;
            day = (day < 10) ? "0" + day : day;

            return year + "-" + month + "-" + day;
        }

        // Set maintenance date dynamically
        window.onload = function() {
            var maintenanceDateElement = document.getElementById("maintenance-date");
            maintenanceDateElement.innerHTML = getNextDayESTDate();
            maintenanceDateElement.innerHTML = "2025-05-21";
        };
    </script>
</head>
